%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% NO-OPT BOOLEAN OR/AND I-TYPE

itype_nr_sorts = 1;

itype_signature = (
	% the name of the i-type
% 	name:					"no-opt boolean or/and i-type",
	% the category of the i-type
	category:			ITYPE_CATEGORY_SINGLE_SORTED,
	% the tuple of sorts of the i-type
	sorts:					[ITYPE_SORT_BOOL],
	% the operations of the i-type
	operations:		[(ITYPE_AGGREGATION):ITYPE_AGGREGATION_OR, (ITYPE_PROPAGATION):ITYPE_PROPAGATION_AND],
);

itype_domains = (
	cardinalities:	[<>],
);

itype_algebra = (
	% the algebraic properties of the i-type operations
	properties:		[
									(ITYPE_AGGREGATION,	ALGEBRAIC_PROPERTY_HAS_ABSORBING_ELEMENT):	true,
									(ITYPE_AGGREGATION,	ALGEBRAIC_PROPERTY_HAS_NEUTRAL_ELEMENT):		true,
									(ITYPE_AGGREGATION,	ALGEBRAIC_PROPERTY_COMMUTATIVITY):				true,
									(ITYPE_AGGREGATION,	ALGEBRAIC_PROPERTY_ASSOCIATIVITY):				true,
									
									(ITYPE_PROPAGATION,	ALGEBRAIC_PROPERTY_HAS_ABSORBING_ELEMENT):	true,
									(ITYPE_PROPAGATION,	ALGEBRAIC_PROPERTY_HAS_NEUTRAL_ELEMENT):		true,
									(ITYPE_PROPAGATION,	ALGEBRAIC_PROPERTY_COMMUTATIVITY):				true,
									(ITYPE_PROPAGATION,	ALGEBRAIC_PROPERTY_ASSOCIATIVITY):				true,
								],
	% the algebraic elements of the i-type operations
	aggregation_absorbing:	(iblock:[1]),
	aggregation_neutral:		(iblock:[0]),
	propagation_absorbing:	(iblock:[0]),
	propagation_neutral:		(iblock:[1]),	
);